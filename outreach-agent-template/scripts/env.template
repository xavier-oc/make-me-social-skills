# Outreach Agent - Environment Variables Template
# Copy this file to ~/.openclaw/workspace/.env and fill in your credentials
# 
# SECURITY NOTE: The .env file is the recommended way to store credentials.
# If you cannot use a .env file, you may paste credentials directly in Telegram
# and the agent will store them securely. This is less secure but acceptable
# if your OpenClaw instance is private.

# =============================================================================
# EMAIL PROVIDER CREDENTIALS
# =============================================================================
# Replace "PROVIDER" with your email provider name (e.g., ZOHO, GMAIL, SENDGRID)

# OAuth Client ID from your email provider's developer console
PROVIDER_CLIENT_ID=your_client_id_here

# OAuth Client Secret from your email provider's developer console
PROVIDER_CLIENT_SECRET=your_client_secret_here

# Long-lived Refresh Token for OAuth authentication
PROVIDER_REFRESH_TOKEN=your_refresh_token_here

# Your account/organization ID in the email provider system
PROVIDER_ACCOUNT_ID=your_account_id_here

# The email address messages will be sent from
PROVIDER_FROM_ADDRESS=your@email.com

# =============================================================================
# GOOGLE CREDENTIALS (stored separately in credentials/google_oauth.json)
# =============================================================================
# Google credentials are stored in: ~/.openclaw/workspace/credentials/google_oauth.json
# See the setup wizard for instructions on obtaining these.

# =============================================================================
# BUSINESS SETTINGS (optional - can also be set via setup wizard)
# =============================================================================

# Spreadsheet ID for creator outreach (found in Google Sheets URL)
# OUTREACH_SPREADSHEET_ID=your_spreadsheet_id_here
